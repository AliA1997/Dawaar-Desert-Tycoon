# Dawaar API server — environment.
# Copy to .env / set in the deploy platform. Values are examples, never secrets.

# REQUIRED. The port to listen on. The deploy platform normally injects this.
PORT=3001

# Where the JSON snapshots (games.json / players.json) are written.
# Defaults to <api-server>/data, which is correct for both `tsx src/index.ts`
# and the bundled dist/index.cjs. Set it to a mounted volume in production —
# a container's local filesystem does not survive a redeploy.
DATA_DIR=

# Runtime mode. "production" turns on the stricter preflight warnings.
NODE_ENV=development

# Comma-separated browser origins allowed to call the API.
# The React Native client sends no Origin and is unaffected. Leave empty in
# development; set it in production or every web origin is accepted.
CORS_ALLOWED_ORIGINS=

# Largest accepted request body. The biggest legitimate one is a trade (<8kb).
BODY_LIMIT=64kb

# How long a long-poll is parked before answering with the current state (ms).
POLL_TIMEOUT_MS=20000

# Concurrent long-polls allowed per game before the server answers immediately.
MAX_POLL_WAITERS_PER_GAME=24

# Grace period for in-flight requests during shutdown (ms).
SHUTDOWN_TIMEOUT_MS=25000
